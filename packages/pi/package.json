{
  "name": "@relaymessenger/pi",
  "version": "0.1.4-staging.37",
  "description": "Relay Messenger channel for Pi over Relay v1 WebSocket delivery.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.22.3"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/native.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@relaymessenger/sdk": "0.3.6-staging.38"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "staging",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RelayMessenger/Relay-SDK.git",
    "directory": "packages/pi"
  },
  "homepage": "https://github.com/RelayMessenger/Relay-SDK/tree/main/packages/pi#readme",
  "keywords": [
    "relay",
    "pi",
    "pi-package",
    "channel",
    "messaging"
  ]
}
