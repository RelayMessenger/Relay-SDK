{
  "name": "@relaymessenger/think",
  "version": "0.1.1-staging.0",
  "description": "The Relay agent runtime for Cloudflare Think: calls, reactions, replies, locations, payments, typing and history.",
  "keywords": [
    "relay",
    "cloudflare",
    "think",
    "agents",
    "messaging"
  ],
  "homepage": "https://github.com/RelayMessenger/Relay-SDK/tree/main/packages/think",
  "bugs": {
    "url": "https://github.com/RelayMessenger/Relay-SDK/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RelayMessenger/Relay-SDK.git",
    "directory": "packages/think"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.js",
      "default": "./dist/actions.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "staging",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rm -rf dist && node scripts/build.mjs && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:all": "npm run check && npm run build && npm test",
    "prepack": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@relaymessenger/chat-sdk-adapter": "0.3.12-staging.0",
    "@relaymessenger/sdk": "0.5.3-staging.0"
  },
  "peerDependencies": {
    "@cloudflare/think": ">=0.19.0 <1.0.0",
    "ai": "^7.0.107",
    "chat": "^4.41.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/think": "0.19.0",
    "@types/node": "26.6.2",
    "ai": "7.0.107",
    "chat": "4.41.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  }
}
