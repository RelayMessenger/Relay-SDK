{
  "name": "@relaymessenger/livekit",
  "version": "0.1.0-staging.10",
  "description": "Relay WebRTC audio transport and LiveKit Agents integration for Node.js.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js",
      "default": "./dist/transport.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate": "npm run check && npm test && npm run build",
    "prepack": "npm run validate"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "license": "MIT",
  "dependencies": {
    "@evan/opus": "1.0.3",
    "@relaymessenger/sdk": "0.3.6-staging.19",
    "werift": "0.24.4"
  },
  "optionalDependencies": {
    "@roamhq/wrtc": "^0.10.0"
  },
  "peerDependencies": {
    "@livekit/agents": "^1.9.0",
    "@livekit/rtc-node": "^0.13.34"
  },
  "devDependencies": {
    "@livekit/agents": "^1.9.0",
    "@livekit/rtc-node": "^0.13.34",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "staging",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RelayMessenger/Relay-SDK.git",
    "directory": "packages/livekit"
  },
  "homepage": "https://github.com/RelayMessenger/Relay-SDK/tree/main/packages/livekit#readme",
  "keywords": [
    "relay",
    "livekit",
    "webrtc",
    "voice",
    "agents"
  ]
}
