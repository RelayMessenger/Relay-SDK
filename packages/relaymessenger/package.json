{
  "name": "@relaymessenger/cli",
  "version": "0.4.1",
  "description": "Relay CLI. Bridge Claude Code, Codex, Hermes Agent, or OpenClaw to Relay. https://relayapp.im",
  "homepage": "https://relayapp.im",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relaymessenger/Relay-SDK.git",
    "directory": "packages/relaymessenger"
  },
  "bugs": {
    "url": "https://github.com/relaymessenger/Relay-SDK/issues"
  },
  "type": "module",
  "bin": {
    "relaymessenger": "dist/cli.js"
  },
  "files": [
    "claude-plugin",
    "dist",
    "openclaw-plugin",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prepack": "node scripts/build-claude-bundle.mjs && npm run clean && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.69.0",
    "@agentclientprotocol/codex-acp": "1.4.0",
    "@agentclientprotocol/sdk": "^1.2.1",
    "@relaymessenger/sdk": "0.2.0",
    "cross-spawn": "7.0.6",
    "qrcode-terminal": "^0.12.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.233",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^26.2.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
