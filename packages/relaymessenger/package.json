{
  "name": "@relaymessenger/cli",
  "version": "0.3.2",
  "description": "Relay CLI. Bridge Claude Code, Codex, Hermes Agent, or OpenClaw to Relay. https://relayapp.im",
  "homepage": "https://relayapp.im",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relaymessenger/relay-cli.git",
    "directory": "packages/relaymessenger"
  },
  "bugs": {
    "url": "https://github.com/relaymessenger/relay-cli/issues"
  },
  "type": "module",
  "bin": {
    "relaymessenger": "dist/cli.js"
  },
  "files": [
    "claude-plugin",
    "dist",
    "openclaw-plugin",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prepack": "node scripts/build-claude-bundle.mjs && npm run clean && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.64.0",
    "@agentclientprotocol/codex-acp": "1.1.8",
    "@agentclientprotocol/sdk": "^1.2.1",
    "cross-spawn": "7.0.6",
    "qrcode-terminal": "^0.12.0",
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.220",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^26.1.2",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
