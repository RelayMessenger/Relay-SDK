{
  "name": "@relaymessenger/cli",
  "version": "0.5.0-staging.0",
  "description": "Official command-line client for Relay v1 resources.",
  "type": "module",
  "bin": {
    "relay": "./dist/cli.js",
    "relaymessenger": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "contract:check": "node scripts/check-contract.mjs",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "pack:smoke": "node scripts/tarball-smoke.mjs",
    "validate": "npm run clean && npm run check && npm run build && npm test && npm run contract:check && npm run boundaries:check && npm run pack:smoke",
    "prepack": "npm run validate"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "license": "MIT",
  "dependencies": {
    "@relaymessenger/sdk": "0.3.0-staging.4",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "staging",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RelayMessenger/Relay-SDK.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/RelayMessenger/Relay-SDK/issues"
  },
  "homepage": "https://docs.relayapp.im"
}
