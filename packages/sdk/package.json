{
  "name": "@relaymessenger/sdk",
  "version": "0.3.7-staging.5",
  "description": "TypeScript SDK for the Relay v1 messaging API, signed webhooks, and Relay Calls.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./calls": {
      "types": "./dist/calls/index.d.ts",
      "import": "./dist/calls/index.js",
      "default": "./dist/calls/index.js"
    },
    "./login-button": {
      "types": "./dist/login-button/index.d.ts",
      "import": "./dist/login-button/index.js",
      "default": "./dist/login-button/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "LICENSE",
    "LICENSES/",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "license": "MIT",
  "dependencies": {
    "@a2a-js/sdk": "^1.2.1",
    "jose": "^6.2.12",
    "standardwebhooks": "^1.1.1",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@evan/opus": "1.0.3",
    "@roamhq/wrtc": "^0.10.0",
    "node-webcodecs": "1.3.0",
    "rtp-packet": "0.4.2",
    "werift": "0.24.4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@evan/opus": {
      "optional": true
    },
    "@roamhq/wrtc": {
      "optional": true
    },
    "node-webcodecs": {
      "optional": true
    },
    "rtp-packet": {
      "optional": true
    },
    "werift": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@evan/opus": "1.0.3",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "rtp-packet": "0.4.2",
    "werift": "0.24.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "staging"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RelayMessenger/Relay-SDK.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.relayapp.im",
  "keywords": [
    "relay",
    "messaging",
    "agents",
    "webhooks"
  ]
}
