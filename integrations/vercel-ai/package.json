{
  "name": "@relaymessenger/vercel-ai",
  "version": "0.2.1",
  "description": "Relay plugin for the Vercel AI SDK. Receive signed Relay webhooks and stream replies as one canonical message.",
  "homepage": "https://docs.relayapp.im/guides/vercel-ai-sdk",
  "bugs": {
    "url": "https://github.com/relaymessenger/Relay-SDK/issues"
  },
  "license": "MIT",
  "keywords": [
    "relay",
    "vercel",
    "ai-sdk",
    "messaging",
    "agent",
    "webhook"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ai": "^7.0.77",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relaymessenger/Relay-SDK.git",
    "directory": "integrations/vercel-ai"
  }
}
