{
  "name": "@relayapp/openclaw-plugin",
  "version": "0.1.0",
  "description": "Relay channel plugin for OpenClaw — text your OpenClaw like a friend.",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "relay",
    "messaging",
    "agent"
  ],
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "README.md",
    "index.ts",
    "setup-entry.ts",
    "openclaw.plugin.json",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "gateway:harness": "node scripts/gateway-harness.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.7.2-beta.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.2-beta.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "relay",
      "label": "Relay",
      "selectionLabel": "Relay",
      "detailLabel": "Relay",
      "blurb": "Text your OpenClaw like a friend.",
      "systemImage": "message",
      "markdownCapable": false
    }
  }
}
