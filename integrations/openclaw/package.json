{
  "name": "@relayapp/openclaw-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Relay channel plugin for OpenClaw — text your OpenClaw like a friend.",
  "type": "module",
  "files": [
    "README.md",
    "index.ts",
    "setup-entry.ts",
    "openclaw.plugin.json",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.7.2-beta.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.2-beta.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "relay",
      "label": "Relay",
      "selectionLabel": "Relay",
      "detailLabel": "Relay",
      "blurb": "Text your OpenClaw like a friend.",
      "systemImage": "message",
      "markdownCapable": false
    }
  }
}
