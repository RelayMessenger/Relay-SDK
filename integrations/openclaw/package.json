{
  "name": "@relaymessenger/openclaw-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Relay channel plugin for OpenClaw. Text your OpenClaw like a friend.",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "relay",
    "messaging",
    "agent"
  ],
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relaymessenger/relay-cli.git",
    "directory": "integrations/openclaw"
  },
  "type": "module",
  "files": [
    "README.md",
    "index.ts",
    "setup-entry.ts",
    "openclaw.plugin.json",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "gateway:harness": "node scripts/gateway-harness.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@openclaw/fs-safe": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.7.2-beta.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.2-beta.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.7.2-beta.5"
    },
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./setup-entry.ts",
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "relay",
      "label": "Relay",
      "selectionLabel": "Relay",
      "detailLabel": "Relay",
      "blurb": "Text your OpenClaw like a friend.",
      "systemImage": "message",
      "markdownCapable": false
    }
  }
}
