{
  "id": "relay",
  "name": "Relay",
  "description": "Relay channel plugin. Connects an OpenClaw agent to a Relay contact.",
  "channels": [
    "relay"
  ],
  "channelEnvVars": {
    "relay": [
      "RELAY_AGENT_TOKEN",
      "RELAY_BASE_URL"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "relay": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "token": {
            "type": "string"
          },
          "tokenFile": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pollTimeoutSeconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 30
          },
          "defaultAccount": {
            "type": "string"
          },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "token": {
                  "type": "string"
                },
                "tokenFile": {
                  "type": "string"
                },
                "baseUrl": {
                  "type": "string"
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "pollTimeoutSeconds": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 30
                }
              }
            }
          }
        }
      },
      "uiHints": {
        "token": {
          "label": "Agent Token",
          "sensitive": true
        },
        "baseUrl": {
          "label": "Relay API base URL"
        }
      }
    }
  }
}
