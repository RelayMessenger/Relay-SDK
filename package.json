{
  "name": "relay-sdk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk"
  ],
  "scripts": {
    "clean": "npm run clean --workspace @relaymessenger/sdk",
    "check": "npm run check --workspace @relaymessenger/sdk",
    "build": "npm run build --workspace @relaymessenger/sdk",
    "test": "npm run test --workspace @relaymessenger/sdk",
    "contract:check": "node scripts/validate-contract.mjs && node scripts/validate-contract-failures.mjs",
    "consumer:types": "tsc -p test/tsconfig.json --noEmit",
    "pack:smoke": "node scripts/consumer-smoke.mjs",
    "staging:validate": "node scripts/staging-validate.mjs",
    "staging:validate:structural": "node scripts/staging-validate.mjs --structural",
    "validate": "npm run clean && npm run check && npm run build && npm test && npm run contract:check && npm run consumer:types && npm run pack:smoke && npm run staging:validate:structural"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
