{
  "name": "relay-sdk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk"
  ],
  "scripts": {
    "clean": "npm run clean --workspace @relayapp/sdk",
    "check": "npm run check --workspace @relayapp/sdk",
    "build": "npm run build --workspace @relayapp/sdk",
    "test": "npm run test --workspace @relayapp/sdk",
    "contract:check": "node scripts/validate-contract.mjs",
    "consumer:types": "tsc -p test/tsconfig.json --noEmit",
    "pack:smoke": "node scripts/consumer-smoke.mjs",
    "validate": "npm run clean && npm run check && npm run build && npm test && npm run contract:check && npm run consumer:types && npm run pack:smoke"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
