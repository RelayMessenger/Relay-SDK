{
  "name": "@relaymessenger/cookbook-webhook-receiver",
  "version": "1.0.0",
  "private": true,
  "description": "Signed Relay Webhook receiver with durable acceptance and idempotent replies.",
  "type": "module",
  "scripts": {
    "build:native": "node scripts/build-private-sqlite-helper.mjs",
    "prestart": "npm run build:native",
    "start": "tsx src/server.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "prebuild": "npm run build:native",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build:native",
    "test": "vitest run",
    "test:installed": "node scripts/test-installed-template.mjs",
    "test:all": "npm run check && npm run build && npm test && npm run test:installed"
  },
  "dependencies": {
    "@relaymessenger/sdk": "0.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RelayMessenger/Relay-SDK.git",
    "directory": "cookbook/webhook-receiver"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RelayMessenger/Relay-SDK/issues"
  }
}
