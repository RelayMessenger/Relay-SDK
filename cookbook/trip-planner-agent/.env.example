# Agent Token for the Relay agent that will join the trip Chat.
# Relay Console -> your agent -> Agent Tokens.
RELAY_AGENT_TOKEN=relay_sk_replace_me

# Anthropic API key used for the planning turn.
# https://console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Relay API origin. Omit for production (https://api.relayapp.im).
RELAY_API_URL=https://api.staging.relayapp.im

# Where the durable inbox and the saved plans live.
# Omit for ~/.relay/examples/trip-planner/state.db
RELAY_STATE_PATH=
