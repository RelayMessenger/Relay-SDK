{
  "name": "@relaymessenger/cookbook-trip-planner-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Group trip-planning Relay agent that answers when mentioned and keeps one living plan per Chat.",
  "type": "module",
  "scripts": {
    "start": "tsx src/process.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:installed": "node scripts/test-installed-template.mjs",
    "test:all": "npm run check && npm run build && npm test && npm run test:installed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "@relaymessenger/sdk": "0.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RelayMessenger/Relay-SDK.git",
    "directory": "cookbook/trip-planner-agent"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RelayMessenger/Relay-SDK/issues"
  }
}
